{
  "name": "hust-world-personal",
  "version": "1.0.0",
  "description": "Personal continuation edition of a HUST-inspired campus simulation RPG.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "smoke:api": "node tools/tests/smoke-api.js",
    "cleanup:smoke": "node tools/tests/cleanup-smoke-data.js",
    "init:data": "node tools/database/init-data.js",
    "init:club-tasks": "node tools/database/init-club-tasks.js",
    "check:config": "node tools/checks/check-config.js",
    "check:db": "node tools/tests/test-db.js",
    "check:npcs": "node tools/checks/check-npcs.js",
    "test:running": "node tools/tests/test-running-api.js",
    "test:side-quests": "node tools/tests/browser-test-side-quests.js",
    "test:map-poi": "node tools/tests/browser-test-map-poi.js",
    "test:map-scenes": "node tools/tests/browser-test-map-scenes.js",
    "test:map": "node tools/tests/browser-test-map-poi.js && node tools/tests/browser-test-map-scenes.js && node tools/tests/browser-test-map-ui.js",
    "test:map-ui": "node tools/tests/browser-test-map-ui.js",
    "test:npc-dialogue": "node tools/tests/browser-test-npc-dialogue.js",
    "test:npc-map": "node tools/tests/browser-test-npc-map.js",
    "test:shop": "node tools/tests/browser-test-shop.js",
    "test:npc": "node tools/tests/browser-test-npc-dialogue.js && node tools/tests/browser-test-npc-map.js && node tools/tests/browser-test-shop.js",
    "test:quest": "node tools/tests/browser-test-quest-system.js",
    "test:growth": "node tools/tests/browser-test-growth-system.js",
    "test:skills": "node tools/tests/browser-test-skills-system.js",
    "test:inventory": "node tools/tests/browser-test-inventory-system.js",
    "test:linkage": "node tools/tests/browser-test-linkage.js",
    "test:dashboard": "node tools/tests/browser-test-game-dashboard.js",
    "test:game-dashboard": "node tools/tests/browser-test-game-dashboard.js",
    "test:campus-week": "node tools/tests/browser-test-campus-week.js",
    "test:panels-ui": "node tools/tests/browser-test-panels-ui.js",
    "test:ui-layout": "node tools/tests/browser-test-ui-layout.js",
    "test:responsive": "node tools/tests/browser-test-responsive-motion.js",
    "test:phase9": "node tools/tests/browser-test-phase9-final.js",
    "quality:gate": "node tools/tests/quality-gate.js",
    "test:services": "node tools/tests/service-level.js",
    "test:e2e": "node tools/tests/browser-test-critical-flows.js",
    "test:quick": "node tools/tests/test-matrix.js quick",
    "test:standard": "node tools/tests/test-matrix.js standard",
    "test:full": "node tools/tests/test-matrix.js full"
  },
  "keywords": ["game", "campus", "simulation", "rpg", "hust", "web-game"],
  "author": "Jiatong",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiatong1008/HUST-WORLD.git"
  },
  "bugs": {
    "url": "https://github.com/Jiatong1008/HUST-WORLD/issues"
  },
  "homepage": "https://github.com/Jiatong1008/HUST-WORLD#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "playwright": "^1.61.1"
  }
}
