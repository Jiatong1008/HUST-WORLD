# HUST WORLD 环境变量配置示例
# 复制此文件为 .env 后修改为你的本地配置

# 数据库配置（必需）
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=123456
DB_NAME=hust_world
DB_PORT=3306

# 服务器配置
PORT=8080
SMOKE_API_BASE=http://localhost:8080
NODE_ENV=development

# JWT 鉴权密钥（生产环境请务必修改为高强度随机字符串）
JWT_SECRET=your-secret-key-here-make-it-very-long-and-complex

# CORS 配置（可选，默认允许所有来源）
# CORS_ORIGIN=http://localhost:8080
