# Keep source files consistent across Windows, macOS and Linux contributors.
* text=auto eol=lf

# Windows launch and maintenance scripts should retain CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Do not attempt line-ending conversion or diffs for binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
