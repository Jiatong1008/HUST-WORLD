# Copy to .env.docker before running docker compose.
# Use unique, strong secrets; do not commit the copied file.
DB_NAME=hust_world
DB_USER=hust_app
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_DATABASE=hust_world
MYSQL_USER=hust_app
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-strong-root-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
